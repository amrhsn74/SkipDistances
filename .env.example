# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Database -------------------------------------------------------------
# SQLite. Path is relative to the project root (Prisma 7 resolves it from
# prisma.config.ts, not from the schema file). `npm run db:reset` sets it up.
DATABASE_URL="file:./prisma/dev.db"

# --- Gemini ---------------------------------------------------------------
# Used by the Guarded Content Engine (Phase 3) for brief analysis, plan
# generation, and the compliance check. Get a key at https://aistudio.google.com/apikey
# Without it, Phases 1-2 still run; the engine does not.
GEMINI_API_KEY=""

# Model id. Pinned to an explicit version, not a `-latest` alias: aliases are
# hot-swapped on each release, which would make the Phase 12 evaluation
# non-reproducible. Verified against ai.google.dev/gemini-api/docs/models
# (2026-08-24); re-check before a build, Google retires versions on a rolling basis.
GEMINI_MODEL="gemini-3.1-flash-lite"

# Image model, for visual content forms (image, video, reel, photoshoot).
# A separate model from GEMINI_MODEL and not interchangeable with it: a text
# model answers an image request with prose. Must be a model whose name ends in
# -image. Verified against ListModels 2026-08-26; note that the Imagen models and
# the SDK's generateImages method are NOT usable here -- 404, not supported for
# predict. Unset is fine: the text path is unaffected and visual items simply
# arrive without a picture.
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# --- Instagram (Phase 9) --------------------------------------------------
# Meta developer app, Development mode, one tester-added Professional account.
# See README for the setup walkthrough. Not needed before Phase 9.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/instagram/callback"

# 32-byte key for encrypting PlatformConnection.access_token at rest (Phase 9).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""
